<Window x:Class="DbIzleyici.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DbIzleyici.Views"
        xmlns:vm="clr-namespace:DbIzleyici.Vm"
        xmlns:local="clr-namespace:DbIzleyici"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="DB İzleyici (S7.Net+)" Width="1100" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        Background="{StaticResource Bg}">

    <Window.Resources>
        <ObjectDataProvider x:Key="VarTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:VarType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <DockPanel>

        <!-- Bağlantı çubuğu -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" Padding="14,10"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="IP" Margin="0,0,6,0"/>
                <TextBox Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                <TextBlock Text="CPU" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding CpuTypes}" SelectedItem="{Binding Cpu}" Width="100"/>
                <TextBlock Text="Rack" Margin="0,0,6,0"/>
                <TextBox Text="{Binding Rack, UpdateSourceTrigger=PropertyChanged}" Width="46"/>
                <TextBlock Text="Slot" Margin="0,0,6,0"/>
                <TextBox Text="{Binding Slot, UpdateSourceTrigger=PropertyChanged}" Width="46"/>
                <TextBlock Text="Periyot ms" Margin="0,0,6,0"/>
                <TextBox Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}" Width="66"/>
                <Button Content="{Binding ConnectText}" Command="{Binding ToggleConnectCommand}"
                        Style="{StaticResource AccentButton}" Width="90" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <!-- Alt eylem çubuğu -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" Padding="14,10"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Değer" Margin="0,0,6,0"/>
                <TextBox Text="{Binding WriteValue, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                <Button Content="Seçiliye yaz" Command="{Binding WriteSelectedCommand}"/>
                <Button Content="Bool dizisi ekle" Command="{Binding AddBoolArrayCommand}"/>
                <Button Content="Toplu / tek tek süre ölç" Command="{Binding BenchCommand}"/>
                <CheckBox Content="Yazmaya izin ver" IsChecked="{Binding AllowWrite}" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding StatsText}" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- Günlük -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" Padding="8,4"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Height="130">
            <ListBox x:Name="LogList" ItemsSource="{Binding Log}" Background="Transparent"
                     BorderThickness="0" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextMuted}" Focusable="False"/>
        </Border>

        <!-- Ana alan: kanallar -->
        <TabControl Margin="12">
            <TabItem Header="Bool (16×16)">
                <views:BoolArrayView DataContext="{Binding Bool}"/>
            </TabItem>
            <TabItem Header="Sayı (LReal/Real/DInt/Int)">
                <views:NumberArrayView DataContext="{Binding Number}"/>
            </TabItem>
            <TabItem Header="String">
                <views:StringArrayView DataContext="{Binding Str}"/>
            </TabItem>
            <TabItem Header="Değişkenler">
                <DataGrid ItemsSource="{Binding Vars}" SelectedItem="{Binding SelectedVariable}"
                          Margin="10" CanUserAddRows="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ad" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                        <DataGridComboBoxColumn Header="Tip" SelectedItemBinding="{Binding Type}" Width="90"
                                                ItemsSource="{Binding Source={StaticResource VarTypeValues}}"/>
                        <DataGridTextColumn Header="DB" Binding="{Binding Db}" Width="60"/>
                        <DataGridTextColumn Header="Ofset" Binding="{Binding Offset}" Width="70"/>
                        <DataGridTextColumn Header="Bit" Binding="{Binding Bit}" Width="50"/>
                        <DataGridTextColumn Header="Değer" Binding="{Binding Value}" IsReadOnly="True" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
