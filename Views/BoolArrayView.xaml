<UserControl x:Class="DbIzleyici.Views.BoolArrayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ayarlar -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="DB" Margin="0,0,6,0"/>
            <TextBox Text="{Binding Db, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
            <TextBlock Text="From bayt" Margin="0,0,6,0"/>
            <TextBox Text="{Binding FromStart, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
            <TextBlock Text="To bayt" Margin="0,0,6,0"/>
            <TextBox Text="{Binding ToStart, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
            <CheckBox Content="Oku" IsChecked="{Binding IsReadEnabled}"/>
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Bad}"/>
        </WrapPanel>

        <!-- From (solda, yalnız okuma) ve To (sağda, tıkla: ters çevir ve yaz) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="From (yalnız okuma)" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding From}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="1" Height="26" CornerRadius="3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Surface}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Known}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Index}" HorizontalAlignment="Center" FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                    <Setter Property="Foreground" Value="#0C1E16"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="To (tıkla: ters çevir ve yaz)" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                <ItemsControl x:Name="ToCells" ItemsSource="{Binding To}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="1" Height="26" CornerRadius="3" Cursor="Hand"
                                    MouseLeftButtonUp="ToCell_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Surface}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Known}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Index}" HorizontalAlignment="Center" FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                    <Setter Property="Foreground" Value="#0C1E16"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
