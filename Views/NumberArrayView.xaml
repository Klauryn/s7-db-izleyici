<UserControl x:Class="DbIzleyici.Views.NumberArrayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="DB" Margin="0,0,6,0"/>
            <TextBox Text="{Binding Db, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
            <TextBlock Text="From bayt" Margin="0,0,6,0"/>
            <TextBox Text="{Binding FromStart, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
            <TextBlock Text="To bayt" Margin="0,0,6,0"/>
            <TextBox Text="{Binding ToStart, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
            <TextBlock Text="Adet" Margin="0,0,6,0"/>
            <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
            <TextBlock Text="Tip" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Width="130"/>
            <CheckBox Content="Oku" IsChecked="{Binding IsReadEnabled}"/>
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Bad}"/>
        </WrapPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}"
                  CellEditEnding="Grid_CellEditEnding" BeginningEdit="Grid_BeginningEdit">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No" Binding="{Binding Index}" IsReadOnly="True" Width="60"/>
                <DataGridTextColumn Header="From (yalnız okuma)" Binding="{Binding From}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="To (düzenle, Enter ile yaz)" Binding="{Binding To, UpdateSourceTrigger=LostFocus}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
